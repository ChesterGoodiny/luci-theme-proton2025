	// ÃÅ¸Ã‘â‚¬ÃÂ¸ÃÂ¼ÃÂµÃ‘â‚¬: { "radio0": { band: "2g", interfaces: ["default_radio0"] }, "MT7981_1_1": { band: "5g", interfaces: ["default_MT7981_1_1"] } }
	var _protonWirelessMap = {{ sprintf('%J', wirelessMap) }};
	window._protonWirelessMap = _protonWirelessMap;

	// Set ÃÂ´ÃÂ»Ã‘Â ÃÂ±Ã‘â€¹Ã‘ÂÃ‘â€šÃ‘â‚¬ÃÂ¾ÃÂ¹ ÃÂ¿Ã‘â‚¬ÃÂ¾ÃÂ²ÃÂµÃ‘â‚¬ÃÂºÃÂ¸ ÃÂ¸ÃÂ¼Ã‘â€˜ÃÂ½ Ã‘Æ’Ã‘ÂÃ‘â€šÃ‘â‚¬ÃÂ¾ÃÂ¹Ã‘ÂÃ‘â€šÃÂ² (ÃÂ¾ÃÂ±Ã‘â‚¬ÃÂ°Ã‘â€šÃÂ½ÃÂ°Ã‘Â Ã‘ÂÃÂ¾ÃÂ²ÃÂ¼ÃÂµÃ‘ÂÃ‘â€šÃÂ¸ÃÂ¼ÃÂ¾Ã‘ÂÃ‘â€šÃ‘Å’)
	var _deviceNames = Object.keys(_protonWirelessMap);
	window._protonWirelessDevices = new Set(_deviceNames);

	// ÃÅ¾ÃÂ±Ã‘â‚¬ÃÂ°Ã‘â€šÃÂ½ÃÂ°Ã‘Â ÃÂºÃÂ°Ã‘â‚¬Ã‘â€šÃÂ°: UCI section Ã¢â€ â€™ radioName (ÃÂ´ÃÂ»Ã‘Â ÃÂ±Ã‘â€¹Ã‘ÂÃ‘â€šÃ‘â‚¬ÃÂ¾ÃÂ³ÃÂ¾ ÃÂ¼ÃÂ°ÃÂ¿ÃÂ¿ÃÂ¸ÃÂ½ÃÂ³ÃÂ° AP Ã¢â€ â€™ radio)
	var _ifaceToRadio = {};
