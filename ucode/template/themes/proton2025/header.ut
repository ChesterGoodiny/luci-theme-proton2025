{#
   ÃÂ¤ÃÂ°ÃÂ·ÃÂ° 2B-3: ÃÂ¿ÃÂ¾Ã‘â€žÃÂ°ÃÂ¹ÃÂ»ÃÂ¾ÃÂ²Ã‘â€¹ÃÂ¹ per-page CSS. cascade.css Ã‘ÂÃÂ¾ÃÂ´ÃÂµÃ‘â‚¬ÃÂ¶ÃÂ¸Ã‘â€š Ã‘â€šÃÂ¾ÃÂ»Ã‘Å’ÃÂºÃÂ¾ ÃÂ¾ÃÂ±Ã‘â€°ÃÂ¸ÃÂµ
   Ã‘ÂÃ‘â€šÃÂ¸ÃÂ»ÃÂ¸; ÃÂ¿Ã‘â‚¬ÃÂ°ÃÂ²ÃÂ¸ÃÂ»ÃÂ°, ÃÂ¿Ã‘â‚¬ÃÂ¸ÃÂ²Ã‘ÂÃÂ·ÃÂ°ÃÂ½ÃÂ½Ã‘â€¹ÃÂµ ÃÂº ÃÂºÃÂ¾ÃÂ½ÃÂºÃ‘â‚¬ÃÂµÃ‘â€šÃÂ½ÃÂ¾ÃÂ¹ Ã‘ÂÃ‘â€šÃ‘â‚¬ÃÂ°ÃÂ½ÃÂ¸Ã‘â€ ÃÂµ Ã‘â€¡ÃÂµÃ‘â‚¬ÃÂµÃÂ· body[data-page],
   ÃÂ²Ã‘â€¹ÃÂ½ÃÂµÃ‘ÂÃÂµÃÂ½Ã‘â€¹ ÃÂ² cascade-<page>.css ÃÂ¸ ÃÂ³Ã‘â‚¬Ã‘Æ’ÃÂ·Ã‘ÂÃ‘â€šÃ‘ÂÃ‘Â ÃÂ¢ÃÅ¾Ãâ€ºÃÂ¬ÃÅ¡ÃÅ¾ ÃÂ½ÃÂ° Ã‘ÂÃÂ²ÃÂ¾ÃÂµÃÂ¹ Ã‘ÂÃ‘â€šÃ‘â‚¬ÃÂ°ÃÂ½ÃÂ¸Ã‘â€ ÃÂµ.
   __page ÃÂ²Ã‘â€¹Ã‘â€¡ÃÂ¸Ã‘ÂÃÂ»Ã‘ÂÃÂµÃ‘â€šÃ‘ÂÃ‘Â Ã‘â€šÃÂ°ÃÂº ÃÂ¶ÃÂµ, ÃÂºÃÂ°ÃÂº ÃÂ´ÃÂ»Ã‘Â ÃÂ°Ã‘â€šÃ‘â‚¬ÃÂ¸ÃÂ±Ã‘Æ’Ã‘â€šÃÂ° data-page ÃÂ½ÃÂ° <body> ÃÂ½ÃÂ¸ÃÂ¶ÃÂµ.
   ÃÂ¡ÃÂ¾ÃÂ²ÃÂ¿ÃÂ°ÃÂ´ÃÂµÃÂ½ÃÂ¸ÃÂµ ÃÂ¿ÃÂ¾ Ã‘â€šÃ‘â‚¬Ã‘â€˜ÃÂ¼ ÃÂ¾ÃÂ¿ÃÂµÃ‘â‚¬ÃÂ°Ã‘â€šÃÂ¾Ã‘â‚¬ÃÂ°ÃÂ¼: '=' Ã‘â€šÃÂ¾Ã‘â€¡ÃÂ½ÃÂ¾ÃÂµ, '^' ÃÂ¿Ã‘â‚¬ÃÂµÃ‘â€žÃÂ¸ÃÂºÃ‘Â, '*' ÃÂ¿ÃÂ¾ÃÂ´Ã‘ÂÃ‘â€šÃ‘â‚¬ÃÂ¾ÃÂºÃÂ°.
-#}
{%
	// ctx.path Ã¢â‚¬â€ Ã‘â‚¬ÃÂ°ÃÂ·Ã‘â‚¬ÃÂµÃ‘Ë†Ã‘â€˜ÃÂ½ÃÂ½Ã‘â€¹ÃÂ¹ Ã‘Æ’ÃÂ·ÃÂµÃÂ» (firstchild/alias), ÃÂ¿ÃÂ¾Ã‘ÂÃ‘â€šÃÂ¾ÃÂ¼Ã‘Æ’ /admin/status/ ÃÂ´ÃÂ°Ã‘â€˜Ã‘â€š admin-status-overview;
	// ctx.request_path ÃÂ¾Ã‘ÂÃ‘â€šÃÂ°Ã‘â€˜Ã‘â€šÃ‘ÂÃ‘Â Ã‘â‚¬ÃÂµÃÂ·ÃÂµÃ‘â‚¬ÃÂ²ÃÂ¾ÃÂ¼: ÃÂ½ÃÂ° Ã‘ÂÃ‘â€šÃ‘â‚¬ÃÂ°ÃÂ½ÃÂ¸Ã‘â€ ÃÂµ ÃÂ»ÃÂ¾ÃÂ³ÃÂ¸ÃÂ½ÃÂ° dispatcher ÃÂ¾ÃÂ±ÃÂ½Ã‘Æ’ÃÂ»Ã‘ÂÃÂµÃ‘â€š ctx.path.
	let __ppage = length(ctx.path) ? join('-', ctx.path) : join('-', ctx.request_path);

	let __perpage = [
		['cascade-dashboard.css',   [['^', 'admin-dashboard']]],
		['cascade-diagnostics.css', [['=', 'admin-network-diagnostics']]],
		['cascade-filemanager.css', [['=', 'admin-system-filemanager']]],
		['cascade-leds.css',        [['=', 'admin-system-leds']]],
		['cascade-logs.css',        [['*', 'logs'], ['*', 'syslog'], ['*', 'dmesg']]],
		['cascade-overview.css',    [['=', 'admin-status-overview']]],
		['cascade-passwall2.css',   [['^', 'admin-services-passwall2']]],
		['cascade-processes.css',   [['=', 'admin-status-processes']]],
		['cascade-proxy.css',       [['*', 'ssclash'], ['*', 'mihomo']]],
		['cascade-realtime.css',    [['=', 'admin-status-realtime-load'], ['=', 'admin-status-realtime-bandwidth'], ['=', 'admin-status-realtime-wireless'], ['=', 'admin-status-realtime-connections'], ['=', 'admin-status-realtime-temperature'], ['^', 'admin-status-realtime']]],
		['cascade-reboot.css',      [['=', 'admin-system-reboot']]],
		['cascade-repokeys.css',    [['=', 'admin-system-admin-repokeys']]],
		['cascade-routes.css',      [['=', 'admin-status-routes']]],
		['cascade-startup.css',     [['=', 'admin-system-startup']]],
		['cascade-statistics.css',  [['^', 'admin-statistics-graphs']]],
		['cascade-status.css',      [['^', 'admin-status']]],
		['cascade-system.css',      [['=', 'admin-system-system']]],
		['cascade-tachyon.css',     [['^', 'admin-services-tachyon']]],
		['cascade-package-manager.css', [['=', 'admin-system-package-manager']]],
		['cascade-temperature.css', [['=', 'admin-status-realtime-temperature']]],
		['cascade-wifihistory.css', [['=', 'admin-status-wifihistory']]]
	];

	for (let entry in __perpage) {
		let __file = entry[0];
		let __match = false;
		for (let cond in entry[1]) {
			let __op = cond[0], __val = cond[1];
			if (__op == '=' && __ppage == __val) { __match = true; break; }
			else if (__op == '^' && substr(__ppage, 0, length(__val)) == __val) { __match = true; break; }
			else if (__op == '*' && index(__ppage, __val) >= 0) { __match = true; break; }
		}
		if (__match)
			print(`<link rel="stylesheet" media="screen" href="${media}/css/pages/${__file}?v=${__pv}" />\n`);
	}
-%}
