 See LICENSE and NOTICE for details.
-#}

{%
	import { getuid, getspnam } from 'luci.core';

	// `|| {}` на оба ubus-вызова: если ubus недоступен (rpcd перезапускается,
	// нет прав в acl) call() отдаёт null, и дальнейшая индексация уронила бы
	// рендер ВСЕЙ страницы — вместо интерфейса пользователь увидел бы 500.
	const boardinfo = ubus.call('system', 'board') || {};
	const wirelessStatus = ubus.call('network.wireless', 'status') || {};

	// Раскладка меню нужна ДО первой отрисовки, иначе свежий браузер рисует
	// верхнее меню и через ~1 с перекидывает его на бок (см. инлайн-скрипт ниже).
	const protonResp = ubus.call('uci', 'get', { config: 'proton2025', section: 'settings' });
	const protonSettings = (protonResp && protonResp.values) ? protonResp.values : {};

	// Строим карту wireless-устройств из ubus:
	// { radioName: { band: "2g"|"5g"|"6g", interfaces: ["default_radio0", ...] }, ... }
	let wirelessMap = {};
	for (let radioName in wirelessStatus) {
		let radio = wirelessStatus[radioName];
		let cfg = (radio && radio.config) ? radio.config : {};
		let band = cfg.band || '';

		// Fallback: определяем band из канала если band не указан
		// NB: 6 GHz (ch 1-233) и 60 GHz (ch 1-6) пересекаются с 2.4 GHz,
		// поэтому по каналу их различить нельзя — полагаемся на config.band
		if (!band && cfg.channel) {
			let ch = +cfg.channel;
			if (ch >= 1 && ch <= 14) band = '2g';
			else if (ch >= 32 && ch <= 177) band = '5g';
		}

		let interfaces = [];
		let ifaces = (radio && type(radio.interfaces) == 'array') ? radio.interfaces : [];
		for (let iface in ifaces) {
			if (iface && iface.section)
				push(interfaces, iface.section);
		}

		wirelessMap[radioName] = { band: band, interfaces: interfaces };
	}

	http.prepare_content('text/html; charset=UTF-8');
-%}

<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}">
<head>
<meta charset="utf-8" />
<script>
(function() {
	function resolveThemeMode(mode) {
		if (mode === 'auto' && window.matchMedia) {
			return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
		}

		return mode === 'light' ? 'light' : 'dark';
	}

	// Применяем тему ДО отрисовки страницы, чтобы избежать мерцания
	var storedThemeMode = localStorage.getItem('proton-theme-mode') || 'auto';
	var themeMode = resolveThemeMode(storedThemeMode);
	if (themeMode === 'light') {
		document.documentElement.setAttribute('data-theme', 'light');
		document.documentElement.setAttribute('data-darkmode', 'false');
	} else {
		document.documentElement.setAttribute('data-theme', 'dark');
		document.documentElement.setAttribute('data-darkmode', 'true');
	}

	// Expose the router hostname so the login-branding setting can
	// pre-fill the display-name field with it.
	window.protonHostname = {{ sprintf('%J', boardinfo.hostname ?? '') }};

	var defaultZoom = '100';
	var z = localStorage.getItem('proton-zoom') || defaultZoom;
	if (window.innerWidth >= 800) {
		document.documentElement.style.zoom = z / 100;
	}
	var t = localStorage.getItem('proton-transparency');
	if (t !== 'false') document.documentElement.classList.add('proton-transparency');
	var r = localStorage.getItem('proton-border-radius');
	if (r === 'sharp') document.documentElement.classList.add('proton-radius-sharp');
	else if (r === 'extra') document.documentElement.classList.add('proton-radius-extra');
	if (localStorage.getItem('proton-tab-outline') === 'true') document.documentElement.classList.add('proton-tab-outline');
	if (localStorage.getItem('proton-tab-style') === 'classic') document.documentElement.classList.add('proton-tabs-classic');
	if (localStorage.getItem('proton-tab-style') === 'proton') document.documentElement.classList.add('proton-tabs-proton');
	var bp = localStorage.getItem('proton-background-pattern') || 'none';
	if (bp === 'noise') bp = 'stars';  // pattern was renamed
	if (bp !== 'none') {
		document.documentElement.classList.add('proton-pattern-' + bp);
		var ps = parseInt(localStorage.getItem('proton-pattern-scale') || '100', 10);
		if (!isNaN(ps) && ps >= 50 && ps <= 200 && ps !== 100)
			document.documentElement.style.setProperty('--proton-pattern-scale', ps / 100);
	}
	var a = localStorage.getItem('proton-accent-color') || 'blue';
	var c = {
		default: { accent: '#4b5563', hover: '#374151', glow: 'rgba(75, 85, 99, 0.22)', rgb: '75, 85, 99' },
		blue:    { accent: '#5e9eff', hover: '#7db2ff', glow: 'rgba(94, 158, 255, 0.18)', rgb: '94, 158, 255' },
		purple:  { accent: '#a78bfa', hover: '#c3b4ff', glow: 'rgba(167, 139, 250, 0.22)', rgb: '167, 139, 250' },
		green:   { accent: '#34d399', hover: '#2fb885', glow: 'rgba(52, 211, 153, 0.18)', rgb: '52, 211, 153' },
		orange:  { accent: '#fb923c', hover: '#f47c1f', glow: 'rgba(251, 146, 60, 0.20)', rgb: '251, 146, 60' },
		red:     { accent: '#f87171', hover: '#f04c4c', glow: 'rgba(248, 113, 113, 0.20)', rgb: '248, 113, 113' }
	};
	if (a === 'custom') {
		var hx = (localStorage.getItem('proton-accent-custom') || '#5e9eff').trim().replace(/^#/, '');
		if (/^[0-9a-fA-F]{3}$/.test(hx)) hx = hx.replace(/(.)/g, '$1$1');
		if (/^[0-9a-fA-F]{6}$/.test(hx)) {
			var rr = parseInt(hx.slice(0, 2), 16), gg = parseInt(hx.slice(2, 4), 16), bb = parseInt(hx.slice(4, 6), 16);
			var lt = function (v) { return Math.round(v + (255 - v) * 0.2); };
			var th = function (v) { return ('0' + v.toString(16)).slice(-2); };
			c.custom = { accent: '#' + hx, hover: '#' + th(lt(rr)) + th(lt(gg)) + th(lt(bb)), glow: 'rgba(' + rr + ', ' + gg + ', ' + bb + ', 0.2)', rgb: rr + ', ' + gg + ', ' + bb };
		}
	}
	if (c[a]) {
		document.documentElement.style.setProperty('--proton-accent', c[a].accent);
		document.documentElement.style.setProperty('--proton-accent-hover', c[a].hover);
		document.documentElement.style.setProperty('--proton-accent-glow', c[a].glow);
		document.documentElement.style.setProperty('--proton-accent-rgb', c[a].rgb);
	}
	if (localStorage.getItem('proton-animations') === 'false') document.documentElement.classList.add('proton-no-animations');
	var pw = localStorage.getItem('proton-page-width');
	if (pw && parseInt(pw) > 0 && window.innerWidth >= 800) {
		document.documentElement.style.setProperty('--proton-page-max-width', pw + '%', 'important');
	} else if (window.innerWidth >= 800) {
		document.documentElement.style.setProperty('--proton-page-max-width', '1200px', 'important');
	}
	// Раскладка меню — единственная настройка, меняющая структуру DOM, поэтому
	// её нельзя ждать от асинхронного settings-sync.js: он догоняет UCI только
	// через секунду, и меню на глазах прыгало из шапки в боковую колонку.
	var uciMenu = {{ sprintf('%J', { mode: protonSettings.menu_mode, collapsed: protonSettings.menu_collapsed }) }};
	var pendingUci = {};
	try { pendingUci = JSON.parse(sessionStorage.getItem('proton-settings-pending') || '{}') || {}; } catch (e) {}
	// Локальный выбор, ещё не подтверждённый ubus: UCI пока отдаёт старое значение.
	if (uciMenu.mode != null && !('menu_mode' in pendingUci))
		localStorage.setItem('proton-menu-mode', uciMenu.mode === 'side' ? 'side' : 'top');
	if (uciMenu.collapsed != null && !('menu_collapsed' in pendingUci))
		localStorage.setItem('proton-menu-collapsed', uciMenu.collapsed === '1' ? 'true' : 'false');
	if (localStorage.getItem('proton-menu-mode') === 'side') {
		document.documentElement.classList.add('proton-menu-side');
		// Класс ставим до первой отрисовки, иначе свёрнутый рельс на мгновение
		// мелькнёт на полной ширине
		if (localStorage.getItem('proton-menu-collapsed') === 'true' && window.innerWidth >= 801)
			document.documentElement.classList.add('proton-menu-collapsed');
	}

	// Логотип из брендинга страницы логина переиспользуется как бейдж рядом с
	// хостнеймом в шапке. Значение подставляется в CSS url(), поэтому строгий
	// allowlist: FileReader всегда отдаёт "data:<type>;base64,<...>", а любой
	// символ вне этого набора мог бы закрыть url() и внедрить свой CSS.
	var LOGO_RE = /^data:image\/(?:png|jpeg|gif|webp|svg\+xml);base64,[A-Za-z0-9+/=]+$/;
	function applyHostnameLogo() {
		var root = document.documentElement;
		var on = localStorage.getItem('proton-login-branding') === 'true';
		var logo = on ? (localStorage.getItem('proton-login-logo') || '') : '';
		if (logo && logo.length < 300001 && LOGO_RE.test(logo)) {
			root.style.setProperty('--proton-hostname-logo', 'url("' + logo + '")');
			root.classList.add('proton-hostname-logo');
		} else {
			root.style.removeProperty('--proton-hostname-logo');
			root.classList.remove('proton-hostname-logo');
		}
	}
	applyHostnameLogo();
	window.protonApplyHostnameLogo = applyHostnameLogo;
	// UCI — источник истины, но синхронизация асинхронна: без этого логотип в
	// новом браузере появился бы только со второй загрузки страницы.
	window.addEventListener('proton-settings-synced', applyHostnameLogo);

	// Устанавливаем фоновый цвет ДО загрузки cascade.css, чтобы избежать мерцания градиента
	var bgSolid = themeMode === 'light' ? '#ffffff' : '#0f1419';
	document.documentElement.style.setProperty('background-color', bgSolid);
})();
</script>
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#0f1419" />
<meta name="color-scheme" content="dark light" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<link rel="preload" href="{{ media }}/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="{{ media }}/fonts/inter-cyrillic.woff2" as="font" type="font/woff2" crossorigin />
{# cyrillic-ext (25 КБ) и latin-ext (72 КБ) НЕ предзагружаем: в них лежат
   глифы, которых нет ни на одной странице UI (⁴, ₴, доп. кириллица),
   а preload тянул их безусловно. unicode-range + font-display: swap в cascade.css
   загрузят сабсет лениво, если редкий глиф всё-таки встретится. #}
<style>
/* Critical: background and gradient before cascade.css to prevent FOUC */
html {
	height: 100%;
	background-color: #0f1419;
}
:root[data-theme="light"] {
	background-color: #ffffff;
}
body {
	min-height: 100%;
	margin: 0;
	background-color: inherit;
	background-image:
		radial-gradient(circle at 20% 30%, rgba(var(--proton-accent-rgb, 94, 158, 255), 0.06) 0%, transparent 50%),
		radial-gradient(circle at 80% 70%, rgba(var(--proton-accent-rgb, 94, 158, 255), 0.03) 0%, transparent 50%),
		linear-gradient(135deg, #0f1419 0%, #1a1f2e 100%);
	background-attachment: fixed;
}
:root[data-theme="light"] body {
	background-image:
		radial-gradient(circle at 20% 30%, rgba(var(--proton-accent-rgb, 75, 85, 99), 0.04) 0%, transparent 50%),
		radial-gradient(circle at 80% 70%, rgba(var(--proton-accent-rgb, 75, 85, 99), 0.025) 0%, transparent 50%),
		linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
}

/* Critical: keep header height stable before cascade.css loads */
:root {
	--proton-page-max-width: 1200px;
	--proton-page-gutter: 20px;
}

#menubar {
	min-height: 64px;
	padding: 0;
}

#menubar-inner {
	display: flex;
	align-items: center;
	gap: 16px;
	height: 64px;
	max-width: var(--proton-page-max-width);
	margin: 0 auto;
	padding: 0 var(--proton-page-gutter);
}

/* Critical: prevent "Loading view…" flash/jump before cascade.css is loaded */
#maincontent > .spinning,
#maincontent > p.spinning,
#view > .spinning,
#view > p.spinning {
	display: flex;
	align-items: center;
	justify-content: center;
	gap: 12px;
	width: 100%;
	min-height: calc(100vh - 64px);
	padding: 24px !important;
	text-align: center;
	padding-left: 0 !important;
}

#maincontent > .spinning::before,
#maincontent > p.spinning::before,
#view > .spinning::before,
#view > p.spinning::before {
	position: static;
	left: auto;
	top: auto;
	margin-top: 0;
}

/* Critical: server-rendered managed alerts must not flash inline before cascade.css */
.alert-message.proton-alert-floating[data-proton-managed="true"] {
	position: fixed;
	top: 84px;
	right: 24px;
	z-index: 2200;
	width: min(420px, calc(100vw - 48px));
	margin-bottom: 0;
	opacity: 0;
	transform: translateY(-10px);
	pointer-events: none;
}

@media (max-width: 800px) {
	.alert-message.proton-alert-floating[data-proton-managed="true"] {
		top: 72px;
		right: 12px;
		width: calc(100vw - 24px);
	}
}
</style>
{% let __pv = "1.4.0"; %}
<link rel="stylesheet" media="screen" fetchpriority="high" href="{{ media }}/css/cascade.css?v={{ __pv }}" />
{#
   Фаза 2B-3: пофайловый per-page CSS. cascade.css содержит только общие
   стили; правила, привязанные к конкретной странице через body[data-page],
   вынесены в cascade-<page>.css и грузятся ТОЛЬКО на своей странице.
   __page вычисляется так же, как для атрибута data-page на <body> ниже.
   Совпадение по трём операторам: '=' точное, '^' префикс, '*' подстрока.
-#}
{%
	// ctx.path — разрешённый узел (firstchild/alias), поэтому /admin/status/ даёт admin-status-overview;
	// ctx.request_path остаётся резервом: на странице логина dispatcher обнуляет ctx.path.
	let __ppage = length(ctx.path) ? join('-', ctx.path) : join('-', ctx.request_path);

	let __perpage = [
		['cascade-dashboard.css',   [['^', 'admin-dashboard']]],
		['cascade-diagnostics.css', [['=', 'admin-network-diagnostics']]],
		['cascade-filemanager.css', [['=', 'admin-system-filemanager']]],
		['cascade-leds.css',        [['=', 'admin-system-leds']]],
		['cascade-logs.css',        [['*', 'logs'], ['*', 'syslog'], ['*', 'dmesg']]],
		['cascade-overview.css',    [['=', 'admin-status-overview']]],
		['cascade-passwall2.css',   [['^', 'admin-services-passwall2']]],
		['cascade-processes.css',   [['=', 'admin-status-processes']]],
		['cascade-proxy.css',       [['*', 'ssclash'], ['*', 'mihomo']]],
		['cascade-realtime.css',    [['=', 'admin-status-realtime-load'], ['=', 'admin-status-realtime-bandwidth'], ['=', 'admin-status-realtime-wireless'], ['=', 'admin-status-realtime-connections'], ['=', 'admin-status-realtime-temperature'], ['^', 'admin-status-realtime']]],
		['cascade-reboot.css',      [['=', 'admin-system-reboot']]],
		['cascade-repokeys.css',    [['=', 'admin-system-admin-repokeys']]],
		['cascade-routes.css',      [['=', 'admin-status-routes']]],
		['cascade-startup.css',     [['=', 'admin-system-startup']]],
		['cascade-status.css',      [['^', 'admin-status']]],
		['cascade-system.css',      [['=', 'admin-system-system']]],
		['cascade-temperature.css', [['=', 'admin-status-realtime-temperature']]],
		['cascade-wifihistory.css', [['=', 'admin-status-wifihistory']]]
	];

	for (let entry in __perpage) {
		let __file = entry[0];
		let __match = false;
		for (let cond in entry[1]) {
			let __op = cond[0], __val = cond[1];
			if (__op == '=' && __ppage == __val) { __match = true; break; }
			else if (__op == '^' && substr(__ppage, 0, length(__val)) == __val) { __match = true; break; }
			else if (__op == '*' && index(__ppage, __val) >= 0) { __match = true; break; }
		}
		if (__match)
			print(`<link rel="stylesheet" media="screen" href="${media}/css/pages/${__file}?v=${__pv}" />\n`);
	}
-%}
<link rel="icon" href="{{ media }}/img/logo.svg" sizes="any" />
{# Cache-buster для JS темы: после обновления файлов пользователи получают
   свежую версию без ручной очистки кэша (uhttpd не шлёт строгие no-cache).
   Инкрементировать при каждом изменении статики темы. #}
{# Словарь переводов ОБЯЗАН быть блокирующим. defer здесь ломает локализацию:
   меню (#mainmenu) и view-модули читают _() один раз в момент отрисовки, а
   ui.menu.load().then(render) при закэшированных модулях успевает выполниться
   за ~65 мс — раньше, чем догрузятся 300 КБ словаря (~250 мс). Метки тогда
   остаются английскими до следующей перерисовки. #}
<script src="{{ dispatcher.build_url('admin/translations', dispatcher.lang) }}"></script>
{# ?v= на luci.js критичен: luci.js парсит версию из собственного URL в
   env.resource_version и дописывает её ко ВСЕМ модулям L.require()
   (menu-proton2025.js, view-модули). Без неё L.require грузит модули
   без версии и браузер отдаёт устаревшие копии после обновления темы.
   type="text/plain" — тег нужен ТОЛЬКО как носитель ?v=: браузер его не
   качает и не исполняет, но querySelectorAll('script[src*="/luci.js"]') в
   LuCI.__init__ его находит первым и берёт версию отсюда. Сам luci.js
   подключает ядро (template/header.ut) — без этого он грузился дважды. #}
<script type="text/plain" src="{{ resource }}/luci.js?v={{ __pv }}"></script>
<script src="{{ resource }}/cbi.js"></script>
{# v1.5.29: строки переводов вынесены в пофайловые локали XX-xx.js.
   Грузим только активную локаль (fallback → en). translations.js оставлен
   как рантайм (protonGetLang + protonT). Порядок defer сохраняется:
   translations.js → локаль → translations-search.js. #}
{%
	let __langBase = lc(substr(dispatcher.lang ?? 'en', 0, 2));
	let __localeMap = {
		en: 'EN-en', ru: 'RU-ru', de: 'DE-de', uk: 'UK-uk', it: 'IT-it',
		fr: 'FR-fr', es: 'ES-es', pt: 'PT-pt', pl: 'PL-pl', zh: 'ZH-zh'
	};
	let __localeFile = __localeMap[__langBase] || 'EN-en';
-%}
<script src="{{ media }}/js/translations.js?v={{ __pv }}" defer></script>
<script src="{{ media }}/i18n/{{ __localeFile }}.js?v={{ __pv }}" defer></script>
<script src="{{ media }}/js/settings-sync.js?v={{ __pv }}" defer></script>
<script src="{{ media }}/js/mobile-settings-fallback.js?v={{ __pv }}" defer></script>
<script src="{{ media }}/js/overview-decorations.js?v={{ __pv }}" defer></script>
<script src="{{ media }}/js/custom-pages.js?v={{ __pv }}" defer></script>
{# translations-search.js: семантические переводы поиска, вынесены из
   translations.js. defer сохраняет порядок → protonGetLang доступен. #}
<script src="{{ media }}/js/translations-search.js?v={{ __pv }}" defer></script>
<script src="{{ media }}/js/search-proton2025-data.js?v={{ __pv }}" defer></script>
<script src="{{ media }}/js/search-proton2025.js?v={{ __pv }}" defer></script>
{# 18.6 КБ + опрос setInterval 20×300мс + MutationObserver ради блока
   #proton-theme-settings, который существует только на Система → Управление.
   На остальных страницах inject() сразу выходит — запрос был впустую.
   Событие proton-theme-settings-mounted тоже шлётся только оттуда. #}
{% if (__ppage == 'admin-system-system'): %}
{# defer безопасен: скрипт сам стартует по readyState/DOMContentLoaded. #}
<script src="{{ media }}/js/login-animation-settings.js?v={{ __pv }}" defer></script>
{% endif %}
{# Фаза 3: клиентский роутинг (SPA). Скрипт САМ-ГЕЙТИТСЯ на клиенте:
   без Navigation API или при выключенном тумблере 'proton-client-routing'
   (по умолчанию OFF) он ничего не делает и тема остаётся классическим MPA.
   Лежит в resources/ (shared), грузится defer после ядра LuCI. #}
<script src="{{ resource }}/router-proton2025.js?v={{ __pv }}" defer></script>

<script>
(function() {
	'use strict';

	var mediaBase = '{{ media }}';
	var localIconBase = mediaBase + '/icons/';

	// Полная карта wireless-устройств из ubus (server-side, zero HTTP overhead)
	// Содержит band и список интерфейсов для каждого radio
	// Пример: { "radio0": { band: "2g", interfaces: ["default_radio0"] }, "MT7981_1_1": { band: "5g", interfaces: ["default_MT7981_1_1"] } }
	var _protonWirelessMap = {{ sprintf('%J', wirelessMap) }};
	window._protonWirelessMap = _protonWirelessMap;

	// Set для быстрой проверки имён устройств (обратная совместимость)
	var _deviceNames = Object.keys(_protonWirelessMap);
	window._protonWirelessDevices = new Set(_deviceNames);

	// Обратная карта: UCI section → radioName (для быстрого маппинга AP → radio)
	var _ifaceToRadio = {};
	for (var rn = 0; rn < _deviceNames.length; rn++) {
		var radioName = _deviceNames[rn];
		var ifaces = _protonWirelessMap[radioName].interfaces || [];
		for (var ii = 0; ii < ifaces.length; ii++) {
			_ifaceToRadio[ifaces[ii]] = radioName;
		}
	}
	window._protonIfaceToRadio = _ifaceToRadio;

	// Проверяет, является ли имя wireless-устройством (radio)
	function isWirelessDevice(name) {
		return window._protonWirelessDevices && window._protonWirelessDevices.has(name);
	}

	// Паттерны для разных типов иконок
	var iconPatterns = [
		{ re: /\/luci-static\/resources\/icons\/signal-(none|\d{3}-\d{3})\.svg$/, prefix: 'proton-signal-' },
		{ re: /\/luci-static\/resources\/icons\/(ethernet|wifi|bridge|tunnel|wireguard|switch|alias|vlan|vrf|port_up|port_down|loading|mobile|radio)(_disabled)?\.svg$/, prefix: 'proton-' }
	];

	var urlCache = window.__protonUrlCache || new WeakMap();
	window.__protonUrlCache = urlCache;
	var rawUrlCache = window.__protonRawUrlCache || new Map();
	window.__protonRawUrlCache = rawUrlCache;

	function remapIcon(img) {
		if (!img || img.tagName !== 'IMG') return;

		var rawSrc = img.getAttribute('src') || img.src;
		if (!rawSrc) return;

		var url = rawUrlCache.get(rawSrc);
		if (!url) {
			try {
				url = new URL(rawSrc, window.location.href);
				rawUrlCache.set(rawSrc, url);
			} catch (e) {
				return;
			}
		}
		urlCache.set(img, url);

		for (var i = 0; i < iconPatterns.length; i++) {
			var match = url.pathname && url.pathname.match(iconPatterns[i].re);
			if (match) {
				var iconName = match[1];
				var suffix = match[2] || '';

				if (iconName === 'wifi') {
					if (img.closest('tr[data-radio-device]')) {
						iconName = 'radio';
					} else {
						var badge = img.closest('.ifacebadge');
						if (badge) {
							var text = badge.textContent.trim();
							if (isWirelessDevice(text)) {
								iconName = 'radio';
							} else if (window._protonWirelessDevices) {
								var devs = Array.from(window._protonWirelessDevices);
								for (var d = 0; d < devs.length; d++) {
									if (text.indexOf(devs[d]) !== -1) {
										iconName = 'radio';
										break;
									}
								}
							}
						}
					}
				}

				var filename = iconPatterns[i].prefix + iconName + suffix + '.svg';
				img.setAttribute('src', localIconBase + filename);
				return;
			}
		}
	}

	function scan(root) {
		if (!root || root.nodeType !== 1) return;
		if (root.tagName === 'IMG') remapIcon(root);
		var imgs = root.querySelectorAll ? root.querySelectorAll('img') : [];
		for (var i = 0; i < imgs.length; i++) remapIcon(imgs[i]);
	}

	// Проставляем data-radio-device и data-band для wireless-строк
	// JS отвечает только за структуру (какой band), CSS — за визуал (цвета)
	// Данные приходят из ubus (server-side карта), без regex-парсинга текста
	// Работает с любыми именами устройств: radio0, MT7981_1_1, ath0, wl0 и т.д.

	var radioMarkTimer = 0;
	function markRadioDevicesAndFreq() {
		var wireless = document.querySelector('#cbi-wireless');
		if (wireless) {
			wireless.setAttribute('data-proton-wireless-pending', 'true');
			wireless.removeAttribute('data-proton-wireless-ready');
		}
		if (radioMarkTimer) {
			clearTimeout(radioMarkTimer);
		}
		radioMarkTimer = setTimeout(function() {
			radioMarkTimer = 0;
			var table = document.querySelector('#cbi-wireless table.cbi-section-table');
			if (!table) return;

			var rows = table.querySelectorAll('tr[data-section-id]');
			var currentBand = null;

			for (var i = 0; i < rows.length; i++) {
				var row = rows[i];
				var sectionId = row.getAttribute('data-section-id') || '';

				if (isWirelessDevice(sectionId)) {
					if (!row.hasAttribute('data-radio-device')) {
						row.setAttribute('data-radio-device', sectionId);
					}
					var mapEntry = _protonWirelessMap[sectionId];
					currentBand = mapEntry ? mapEntry.band : null;

					if (currentBand && !row.hasAttribute('data-band')) {
						row.setAttribute('data-band', currentBand);
					}
					continue;
				}

				if (!row.hasAttribute('data-band')) {
					var parentRadio = _ifaceToRadio[sectionId];
					var band = null;

					if (parentRadio && _protonWirelessMap[parentRadio]) {
						band = _protonWirelessMap[parentRadio].band;
					}

					if (!band && currentBand) {
						band = currentBand;
					}

					if (band) {
						row.setAttribute('data-band', band);
					}
				}
			}

			var readyContainer = document.querySelector('#cbi-wireless');
			if (readyContainer && readyContainer.contains(table)) {
				readyContainer.removeAttribute('data-proton-wireless-pending');
				readyContainer.setAttribute('data-proton-wireless-ready', 'true');
			}
		}, 80);
	}

	function affectsWireless(mutation) {
		if (mutation.type !== 'childList') return false;

		function containsRadioRow(node) {
			return node && node.nodeType === 1 &&
				((node.tagName === 'TR' && node.hasAttribute('data-section-id')) ||
				 (node.querySelector && node.querySelector('tr[data-section-id]')));
		}

		var wireless = document.querySelector('#cbi-wireless');
		for (var i = 0; i < mutation.addedNodes.length; i++) {
			var node = mutation.addedNodes[i];
			if (node.nodeType === 1 &&
				(node.id === 'cbi-wireless' ||
				 (node.querySelector && node.querySelector('#cbi-wireless')) ||
				 node.matches('table.cbi-section-table') ||
				 containsRadioRow(node))) {
				return true;
			}
		}

		if (!wireless || !wireless.contains(mutation.target)) return false;
		for (var j = 0; j < mutation.addedNodes.length; j++) {
			if (containsRadioRow(mutation.addedNodes[j])) return true;
		}
		for (var k = 0; k < mutation.removedNodes.length; k++) {
			if (containsRadioRow(mutation.removedNodes[k])) return true;
		}
		return false;
	}

	function start() {
		scan(document.documentElement);
		markRadioDevicesAndFreq();

		var mo = new MutationObserver(function(mutations) {
			var wirelessChanged = false;

			for (var i = 0; i < mutations.length; i++) {
				var m = mutations[i];
				if (affectsWireless(m)) wirelessChanged = true;
				if (m.type === 'attributes' && m.attributeName === 'src') {
					remapIcon(m.target);
					continue;
				}
				if (m.type === 'childList') {
					for (var j = 0; j < m.addedNodes.length; j++) {
						scan(m.addedNodes[j]);
					}
				}
			}

			if (wirelessChanged) {
				markRadioDevicesAndFreq();
			}
		});

		// Наблюдаем за <body>: модальные окна LuCI (#modal_overlay) создаются
		// прямым потомком body, вне #maincontainer, и иначе остаются без ремапа
		mo.observe(document.body || document.documentElement, {
			subtree: true,
			childList: true,
			attributes: true,
			attributeFilter: ['src']
		});

		window.addEventListener('pagehide', function() {
			if (radioMarkTimer) {
				clearTimeout(radioMarkTimer);
				radioMarkTimer = 0;
			}
			mo.disconnect();
		}, { once: true });
	}

	if (document.readyState === 'loading')
		document.addEventListener('DOMContentLoaded', start);
	else
		start();
})();
</script>
<title>{{ striptags(`${dispatched ? `${dispatched.title} | ` : ''}${boardinfo.hostname ?? '?'}`) }} | LuCI</title>
{% if (css): %}
<style title="text/css">{{ css }}</style>
{% endif %}
</head>
{% let __page = length(ctx.path) ? join('-', ctx.path) : join('-', ctx.request_path); %}
<body class="lang_{{ dispatcher.lang }}" data-page="{{ entityencode(__page, true) }}">

<p class="skiplink">
<span id="skiplink1"><a href="#navigation">{{ _('Skip to navigation') }}</a></span>
<span id="skiplink2"><a href="#content">{{ _('Skip to content') }}</a></span>
</p>

<div id="menubar">
	<div id="menubar-inner">
		<h2 class="navigation"><a id="navigation" name="navigation">{{ _('Navigation') }}</a></h2>

		<span class="hostname"><a href="/">{{ striptags(boardinfo.hostname ?? '?') }}</a></span>
		<div id="mainmenu"></div>
		<div id="proton-search-container"></div>
		<span id="indicators"></span>
	</div>
</div>

<div id="modemenu" style="display:none"></div>

{# Плавающие уведомления вне #maincontent: его animation/transform делает его
   containing block для position:fixed, из-за чего уведомление ехало вместе с
   fade-in страницы и прыгало на своё место в конце анимации. #}
{% if (getuid() == 0 && getspnam('root')?.pwdp === '' && join('-', ctx.request_path) != 'admin-system-admin'): %}
<div class="alert-message warning proton-alert-floating" data-proton-managed="true">
	<h4>{{ _('No password set!') }}</h4>
	<p>{{ _('There is no password set on this router. Please configure a root password to protect the web interface.') }}</p>
	{% if (dispatcher.lookup("admin/system/admin")): %}
		<div class="right"><a class="btn" href="{{ dispatcher.build_url("admin/system/admin") }}">{{ _('Go to password configuration...') }}</a></div>
	{% endif %}
</div>
{% endif %}

{% if (boardinfo.rootfs_type == "initramfs"): %}
<div class="alert-message warning proton-alert-floating" data-proton-managed="true">
	<h4>{{ _('System running in recovery (initramfs) mode.') }}</h4>
	<p>{{ _('No changes to settings will be stored and are lost after rebooting. This mode should only be used to install a firmware upgrade') }}</p>
	{% if (dispatcher.lookup("admin/system/flash")): %}
	  <div class="right"><a class="btn" href="{{ dispatcher.build_url("admin/system/flash") }}">{{ _('Go to firmware upgrade...') }}</a></div>
	{% endif %}
</div>
{% endif %}

<div id="maincontainer">
{# Боковую колонку переставляем уже на этапе парсинга. Если ждать
   menu-proton2025.js (~250 мс), пустой #mainmenu остаётся в шапке, но
   боковые правила к нему уже применяются (proton-menu-side стоит до первой
   отрисовки) — тёмная полоса 72/240px рисуется поверх контента, а сам
   контент идёт на всю ширину и прыгает, когда меню наконец переезжает сюда. #}
	<script>
	(function() {
		var root = document.documentElement;
		if (!root.classList.contains('proton-menu-side') || window.innerWidth < 801)
			return;
		var menu = document.getElementById('mainmenu');
		var container = document.getElementById('maincontainer');
		if (menu && container && menu.parentNode !== container)
			container.insertAdjacentElement('afterbegin', menu);
	})();
	</script>
	<div id="maincontent">
		<div id="tabmenu" style="display:none"></div>
