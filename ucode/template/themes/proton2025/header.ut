{%
	import { getuid, getspnam } from 'luci.core';

	// `|| {}` ÃÂ½ÃÂ° ÃÂ¾ÃÂ±ÃÂ° ubus-ÃÂ²Ã‘â€¹ÃÂ·ÃÂ¾ÃÂ²ÃÂ°: ÃÂµÃ‘ÂÃÂ»ÃÂ¸ ubus ÃÂ½ÃÂµÃÂ´ÃÂ¾Ã‘ÂÃ‘â€šÃ‘Æ’ÃÂ¿ÃÂµÃÂ½ (rpcd ÃÂ¿ÃÂµÃ‘â‚¬ÃÂµÃÂ·ÃÂ°ÃÂ¿Ã‘Æ’Ã‘ÂÃÂºÃÂ°ÃÂµÃ‘â€šÃ‘ÂÃ‘Â,
	// ÃÂ½ÃÂµÃ‘â€š ÃÂ¿Ã‘â‚¬ÃÂ°ÃÂ² ÃÂ² acl) call() ÃÂ¾Ã‘â€šÃÂ´ÃÂ°Ã‘â€˜Ã‘â€š null, ÃÂ¸ ÃÂ´ÃÂ°ÃÂ»Ã‘Å’ÃÂ½ÃÂµÃÂ¹Ã‘Ë†ÃÂ°Ã‘Â ÃÂ¸ÃÂ½ÃÂ´ÃÂµÃÂºÃ‘ÂÃÂ°Ã‘â€ ÃÂ¸Ã‘Â Ã‘Æ’Ã‘â‚¬ÃÂ¾ÃÂ½ÃÂ¸ÃÂ»ÃÂ° ÃÂ±Ã‘â€¹
	// Ã‘â‚¬ÃÂµÃÂ½ÃÂ´ÃÂµÃ‘â‚¬ Ãâ€™ÃÂ¡Ãâ€¢Ãâ„¢ Ã‘ÂÃ‘â€šÃ‘â‚¬ÃÂ°ÃÂ½ÃÂ¸Ã‘â€ Ã‘â€¹ Ã¢â‚¬â€ ÃÂ²ÃÂ¼ÃÂµÃ‘ÂÃ‘â€šÃÂ¾ ÃÂ¸ÃÂ½Ã‘â€šÃÂµÃ‘â‚¬Ã‘â€žÃÂµÃÂ¹Ã‘ÂÃÂ° ÃÂ¿ÃÂ¾ÃÂ»Ã‘Å’ÃÂ·ÃÂ¾ÃÂ²ÃÂ°Ã‘â€šÃÂµÃÂ»Ã‘Å’ Ã‘Æ’ÃÂ²ÃÂ¸ÃÂ´ÃÂµÃÂ» ÃÂ±Ã‘â€¹ 500.
	const boardinfo = ubus.call('system', 'board') || {};
	const wirelessStatus = ubus.call('network.wireless', 'status') || {};

	// ÃÂ ÃÂ°Ã‘ÂÃÂºÃÂ»ÃÂ°ÃÂ´ÃÂºÃÂ° ÃÂ¼ÃÂµÃÂ½Ã‘Å½ ÃÂ½Ã‘Æ’ÃÂ¶ÃÂ½ÃÂ° Ãâ€ÃÅ¾ ÃÂ¿ÃÂµÃ‘â‚¬ÃÂ²ÃÂ¾ÃÂ¹ ÃÂ¾Ã‘â€šÃ‘â‚¬ÃÂ¸Ã‘ÂÃÂ¾ÃÂ²ÃÂºÃÂ¸, ÃÂ¸ÃÂ½ÃÂ°Ã‘â€¡ÃÂµ Ã‘ÂÃÂ²ÃÂµÃÂ¶ÃÂ¸ÃÂ¹ ÃÂ±Ã‘â‚¬ÃÂ°Ã‘Æ’ÃÂ·ÃÂµÃ‘â‚¬ Ã‘â‚¬ÃÂ¸Ã‘ÂÃ‘Æ’ÃÂµÃ‘â€š
	// ÃÂ²ÃÂµÃ‘â‚¬Ã‘â€¦ÃÂ½ÃÂµÃÂµ ÃÂ¼ÃÂµÃÂ½Ã‘Å½ ÃÂ¸ Ã‘â€¡ÃÂµÃ‘â‚¬ÃÂµÃÂ· ~1 Ã‘Â ÃÂ¿ÃÂµÃ‘â‚¬ÃÂµÃÂºÃÂ¸ÃÂ´Ã‘â€¹ÃÂ²ÃÂ°ÃÂµÃ‘â€š ÃÂµÃÂ³ÃÂ¾ ÃÂ½ÃÂ° ÃÂ±ÃÂ¾ÃÂº (Ã‘ÂÃÂ¼. ÃÂ¸ÃÂ½ÃÂ»ÃÂ°ÃÂ¹ÃÂ½-Ã‘ÂÃÂºÃ‘â‚¬ÃÂ¸ÃÂ¿Ã‘â€š ÃÂ½ÃÂ¸ÃÂ¶ÃÂµ).
	const protonResp = ubus.call('uci', 'get', { config: 'proton2025', section: 'settings' });
	const protonSettings = (protonResp && protonResp.values) ? protonResp.values : {};

	// ÃÂ¡Ã‘â€šÃ‘â‚¬ÃÂ¾ÃÂ¸ÃÂ¼ ÃÂºÃÂ°Ã‘â‚¬Ã‘â€šÃ‘Æ’ wireless-Ã‘Æ’Ã‘ÂÃ‘â€šÃ‘â‚¬ÃÂ¾ÃÂ¹Ã‘ÂÃ‘â€šÃÂ² ÃÂ¸ÃÂ· ubus:
	// { radioName: { band: "2g"|"5g"|"6g", interfaces: ["default_radio0", ...] }, ... }
	let wirelessMap = {};
	for (let radioName in wirelessStatus) {
		let radio = wirelessStatus[radioName];
		let cfg = (radio && radio.config) ? radio.config : {};
		let band = cfg.band || '';

		// Fallback: ÃÂ¾ÃÂ¿Ã‘â‚¬ÃÂµÃÂ´ÃÂµÃÂ»Ã‘ÂÃÂµÃÂ¼ band ÃÂ¸ÃÂ· ÃÂºÃÂ°ÃÂ½ÃÂ°ÃÂ»ÃÂ° ÃÂµÃ‘ÂÃÂ»ÃÂ¸ band ÃÂ½ÃÂµ Ã‘Æ’ÃÂºÃÂ°ÃÂ·ÃÂ°ÃÂ½
		// NB: 6 GHz (ch 1-233) ÃÂ¸ 60 GHz (ch 1-6) ÃÂ¿ÃÂµÃ‘â‚¬ÃÂµÃ‘ÂÃÂµÃÂºÃÂ°Ã‘Å½Ã‘â€šÃ‘ÂÃ‘Â Ã‘Â 2.4 GHz,
		// ÃÂ¿ÃÂ¾Ã‘ÂÃ‘â€šÃÂ¾ÃÂ¼Ã‘Æ’ ÃÂ¿ÃÂ¾ ÃÂºÃÂ°ÃÂ½ÃÂ°ÃÂ»Ã‘Æ’ ÃÂ¸Ã‘â€¦ Ã‘â‚¬ÃÂ°ÃÂ·ÃÂ»ÃÂ¸Ã‘â€¡ÃÂ¸Ã‘â€šÃ‘Å’ ÃÂ½ÃÂµÃÂ»Ã‘Å’ÃÂ·Ã‘Â Ã¢â‚¬â€ ÃÂ¿ÃÂ¾ÃÂ»ÃÂ°ÃÂ³ÃÂ°ÃÂµÃÂ¼Ã‘ÂÃ‘Â ÃÂ½ÃÂ° config.band
		if (!band && cfg.channel) {
			let ch = +cfg.channel;
			if (ch >= 1 && ch <= 14) band = '2g';
			else if (ch >= 32 && ch <= 177) band = '5g';
		}

		let interfaces = [];
		let ifaces = (radio && type(radio.interfaces) == 'array') ? radio.interfaces : [];
		for (let iface in ifaces) {
			if (iface && iface.section)
				push(interfaces, iface.section);
		}

		wirelessMap[radioName] = { band: band, interfaces: interfaces };
	}

	http.prepare_content('text/html; charset=UTF-8');
-%}

<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}">
<head>
<meta charset="utf-8" />
<script>
(function() {
	function resolveThemeMode(mode) {
		if (mode === 'auto' && window.matchMedia) {
			return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
		}

		return mode === 'light' ? 'light' : 'dark';
	}

	// ÃÅ¸Ã‘â‚¬ÃÂ¸ÃÂ¼ÃÂµÃÂ½Ã‘ÂÃÂµÃÂ¼ Ã‘â€šÃÂµÃÂ¼Ã‘Æ’ Ãâ€ÃÅ¾ ÃÂ¾Ã‘â€šÃ‘â‚¬ÃÂ¸Ã‘ÂÃÂ¾ÃÂ²ÃÂºÃÂ¸ Ã‘ÂÃ‘â€šÃ‘â‚¬ÃÂ°ÃÂ½ÃÂ¸Ã‘â€ Ã‘â€¹, Ã‘â€¡Ã‘â€šÃÂ¾ÃÂ±Ã‘â€¹ ÃÂ¸ÃÂ·ÃÂ±ÃÂµÃÂ¶ÃÂ°Ã‘â€šÃ‘Å’ ÃÂ¼ÃÂµÃ‘â‚¬Ã‘â€ ÃÂ°ÃÂ½ÃÂ¸Ã‘Â
	var storedThemeMode = localStorage.getItem('proton-theme-mode') || 'auto';
	var themeMode = resolveThemeMode(storedThemeMode);
	if (themeMode === 'light') {
		document.documentElement.setAttribute('data-theme', 'light');
		document.documentElement.setAttribute('data-darkmode', 'false');
	} else {
		document.documentElement.setAttribute('data-theme', 'dark');
		document.documentElement.setAttribute('data-darkmode', 'true');
	}

	// Expose the router hostname so the login-branding setting can
	// pre-fill the display-name field with it.
	window.protonHostname = {{ sprintf('%J', boardinfo.hostname ?? '') }};

	var defaultZoom = '100';
	var z = localStorage.getItem('proton-zoom') || defaultZoom;
	if (window.innerWidth >= 800) {
		document.documentElement.style.zoom = z / 100;
	}
	var t = localStorage.getItem('proton-transparency');
	if (t !== 'false') document.documentElement.classList.add('proton-transparency');
	var r = localStorage.getItem('proton-border-radius');
	if (r === 'sharp') document.documentElement.classList.add('proton-radius-sharp');
	else if (r === 'extra') document.documentElement.classList.add('proton-radius-extra');
	if (localStorage.getItem('proton-tab-outline') === 'true') document.documentElement.classList.add('proton-tab-outline');
	if (localStorage.getItem('proton-tab-style') === 'classic') document.documentElement.classList.add('proton-tabs-classic');
	if (localStorage.getItem('proton-tab-style') === 'proton') document.documentElement.classList.add('proton-tabs-proton');
	var bp = localStorage.getItem('proton-background-pattern') || 'none';
	if (bp === 'noise') bp = 'stars';  // pattern was renamed
	if (bp !== 'none') {
		document.documentElement.classList.add('proton-pattern-' + bp);
		var ps = parseInt(localStorage.getItem('proton-pattern-scale') || '100', 10);
		if (!isNaN(ps) && ps >= 50 && ps <= 200 && ps !== 100)
			document.documentElement.style.setProperty('--proton-pattern-scale', ps / 100);
	}
	var a = localStorage.getItem('proton-accent-color') || 'blue';
	var c = {
		default: { accent: '#4b5563', hover: '#374151', glow: 'rgba(75, 85, 99, 0.22)', rgb: '75, 85, 99' },
		blue:    { accent: '#5e9eff', hover: '#7db2ff', glow: 'rgba(94, 158, 255, 0.18)', rgb: '94, 158, 255' },
		purple:  { accent: '#a78bfa', hover: '#c3b4ff', glow: 'rgba(167, 139, 250, 0.22)', rgb: '167, 139, 250' },
		green:   { accent: '#34d399', hover: '#2fb885', glow: 'rgba(52, 211, 153, 0.18)', rgb: '52, 211, 153' },
		orange:  { accent: '#fb923c', hover: '#f47c1f', glow: 'rgba(251, 146, 60, 0.20)', rgb: '251, 146, 60' },
		red:     { accent: '#f87171', hover: '#f04c4c', glow: 'rgba(248, 113, 113, 0.20)', rgb: '248, 113, 113' }
	};
	if (a === 'custom') {
		var hx = (localStorage.getItem('proton-accent-custom') || '#5e9eff').trim().replace(/^#/, '');
		if (/^[0-9a-fA-F]{3}$/.test(hx)) hx = hx.replace(/(.)/g, '$1$1');
		if (/^[0-9a-fA-F]{6}$/.test(hx)) {
			var rr = parseInt(hx.slice(0, 2), 16), gg = parseInt(hx.slice(2, 4), 16), bb = parseInt(hx.slice(4, 6), 16);
			var lt = function (v) { return Math.round(v + (255 - v) * 0.2); };
			var th = function (v) { return ('0' + v.toString(16)).slice(-2); };
			c.custom = { accent: '#' + hx, hover: '#' + th(lt(rr)) + th(lt(gg)) + th(lt(bb)), glow: 'rgba(' + rr + ', ' + gg + ', ' + bb + ', 0.2)', rgb: rr + ', ' + gg + ', ' + bb };
		}
	}
	if (c[a]) {
		document.documentElement.style.setProperty('--proton-accent', c[a].accent);
		document.documentElement.style.setProperty('--proton-accent-hover', c[a].hover);
		document.documentElement.style.setProperty('--proton-accent-glow', c[a].glow);
		document.documentElement.style.setProperty('--proton-accent-rgb', c[a].rgb);
	}
	if (localStorage.getItem('proton-animations') === 'false') document.documentElement.classList.add('proton-no-animations');
	var pw = localStorage.getItem('proton-page-width');
	if (pw && parseInt(pw) > 0 && window.innerWidth >= 800) {
		document.documentElement.style.setProperty('--proton-page-max-width', pw + '%', 'important');
	} else if (window.innerWidth >= 800) {
		document.documentElement.style.setProperty('--proton-page-max-width', '1200px', 'important');
	}
	// ÃÂ ÃÂ°Ã‘ÂÃÂºÃÂ»ÃÂ°ÃÂ´ÃÂºÃÂ° ÃÂ¼ÃÂµÃÂ½Ã‘Å½ Ã¢â‚¬â€ ÃÂµÃÂ´ÃÂ¸ÃÂ½Ã‘ÂÃ‘â€šÃÂ²ÃÂµÃÂ½ÃÂ½ÃÂ°Ã‘Â ÃÂ½ÃÂ°Ã‘ÂÃ‘â€šÃ‘â‚¬ÃÂ¾ÃÂ¹ÃÂºÃÂ°, ÃÂ¼ÃÂµÃÂ½Ã‘ÂÃ‘Å½Ã‘â€°ÃÂ°Ã‘Â Ã‘ÂÃ‘â€šÃ‘â‚¬Ã‘Æ’ÃÂºÃ‘â€šÃ‘Æ’Ã‘â‚¬Ã‘Æ’ DOM, ÃÂ¿ÃÂ¾Ã‘ÂÃ‘â€šÃÂ¾ÃÂ¼Ã‘Æ’
	// ÃÂµÃ‘â€˜ ÃÂ½ÃÂµÃÂ»Ã‘Å’ÃÂ·Ã‘Â ÃÂ¶ÃÂ´ÃÂ°Ã‘â€šÃ‘Å’ ÃÂ¾Ã‘â€š ÃÂ°Ã‘ÂÃÂ¸ÃÂ½Ã‘â€¦Ã‘â‚¬ÃÂ¾ÃÂ½ÃÂ½ÃÂ¾ÃÂ³ÃÂ¾ settings-sync.js: ÃÂ¾ÃÂ½ ÃÂ´ÃÂ¾ÃÂ³ÃÂ¾ÃÂ½Ã‘ÂÃÂµÃ‘â€š UCI Ã‘â€šÃÂ¾ÃÂ»Ã‘Å’ÃÂºÃÂ¾
	// Ã‘â€¡ÃÂµÃ‘â‚¬ÃÂµÃÂ· Ã‘ÂÃÂµÃÂºÃ‘Æ’ÃÂ½ÃÂ´Ã‘Æ’, ÃÂ¸ ÃÂ¼ÃÂµÃÂ½Ã‘Å½ ÃÂ½ÃÂ° ÃÂ³ÃÂ»ÃÂ°ÃÂ·ÃÂ°Ã‘â€¦ ÃÂ¿Ã‘â‚¬Ã‘â€¹ÃÂ³ÃÂ°ÃÂ»ÃÂ¾ ÃÂ¸ÃÂ· Ã‘Ë†ÃÂ°ÃÂ¿ÃÂºÃÂ¸ ÃÂ² ÃÂ±ÃÂ¾ÃÂºÃÂ¾ÃÂ²Ã‘Æ’Ã‘Å½ ÃÂºÃÂ¾ÃÂ»ÃÂ¾ÃÂ½ÃÂºÃ‘Æ’.
	var uciMenu = {{ sprintf('%J', { mode: protonSettings.menu_mode, collapsed: protonSettings.menu_collapsed }) }};
	var pendingUci = {};
	try { pendingUci = JSON.parse(sessionStorage.getItem('proton-settings-pending') || '{}') || {}; } catch (e) {}
	// Ãâ€ºÃÂ¾ÃÂºÃÂ°ÃÂ»Ã‘Å’ÃÂ½Ã‘â€¹ÃÂ¹ ÃÂ²Ã‘â€¹ÃÂ±ÃÂ¾Ã‘â‚¬, ÃÂµÃ‘â€°Ã‘â€˜ ÃÂ½ÃÂµ ÃÂ¿ÃÂ¾ÃÂ´Ã‘â€šÃÂ²ÃÂµÃ‘â‚¬ÃÂ¶ÃÂ´Ã‘â€˜ÃÂ½ÃÂ½Ã‘â€¹ÃÂ¹ ubus: UCI ÃÂ¿ÃÂ¾ÃÂºÃÂ° ÃÂ¾Ã‘â€šÃÂ´ÃÂ°Ã‘â€˜Ã‘â€š Ã‘ÂÃ‘â€šÃÂ°Ã‘â‚¬ÃÂ¾ÃÂµ ÃÂ·ÃÂ½ÃÂ°Ã‘â€¡ÃÂµÃÂ½ÃÂ¸ÃÂµ.
	if (uciMenu.mode != null && !('menu_mode' in pendingUci))
		localStorage.setItem('proton-menu-mode', uciMenu.mode === 'side' ? 'side' : 'top');
	if (uciMenu.collapsed != null && !('menu_collapsed' in pendingUci))
		localStorage.setItem('proton-menu-collapsed', uciMenu.collapsed === '1' ? 'true' : 'false');
	if (localStorage.getItem('proton-menu-mode') === 'side') {
		document.documentElement.classList.add('proton-menu-side');
		// ÃÅ¡ÃÂ»ÃÂ°Ã‘ÂÃ‘Â Ã‘ÂÃ‘â€šÃÂ°ÃÂ²ÃÂ¸ÃÂ¼ ÃÂ´ÃÂ¾ ÃÂ¿ÃÂµÃ‘â‚¬ÃÂ²ÃÂ¾ÃÂ¹ ÃÂ¾Ã‘â€šÃ‘â‚¬ÃÂ¸Ã‘ÂÃÂ¾ÃÂ²ÃÂºÃÂ¸, ÃÂ¸ÃÂ½ÃÂ°Ã‘â€¡ÃÂµ Ã‘ÂÃÂ²Ã‘â€˜Ã‘â‚¬ÃÂ½Ã‘Æ’Ã‘â€šÃ‘â€¹ÃÂ¹ Ã‘â‚¬ÃÂµÃÂ»Ã‘Å’Ã‘Â ÃÂ½ÃÂ° ÃÂ¼ÃÂ³ÃÂ½ÃÂ¾ÃÂ²ÃÂµÃÂ½ÃÂ¸ÃÂµ
		// ÃÂ¼ÃÂµÃÂ»Ã‘Å’ÃÂºÃÂ½Ã‘â€˜Ã‘â€š ÃÂ½ÃÂ° ÃÂ¿ÃÂ¾ÃÂ»ÃÂ½ÃÂ¾ÃÂ¹ Ã‘Ë†ÃÂ¸Ã‘â‚¬ÃÂ¸ÃÂ½ÃÂµ
		if (localStorage.getItem('proton-menu-collapsed') === 'true' && window.innerWidth >= 801)
			document.documentElement.classList.add('proton-menu-collapsed');
	}

	// Ãâ€ºÃÂ¾ÃÂ³ÃÂ¾Ã‘â€šÃÂ¸ÃÂ¿ ÃÂ¸ÃÂ· ÃÂ±Ã‘â‚¬ÃÂµÃÂ½ÃÂ´ÃÂ¸ÃÂ½ÃÂ³ÃÂ° Ã‘ÂÃ‘â€šÃ‘â‚¬ÃÂ°ÃÂ½ÃÂ¸Ã‘â€ Ã‘â€¹ ÃÂ»ÃÂ¾ÃÂ³ÃÂ¸ÃÂ½ÃÂ° ÃÂ¿ÃÂµÃ‘â‚¬ÃÂµÃÂ¸Ã‘ÂÃÂ¿ÃÂ¾ÃÂ»Ã‘Å’ÃÂ·Ã‘Æ’ÃÂµÃ‘â€šÃ‘ÂÃ‘Â ÃÂºÃÂ°ÃÂº ÃÂ±ÃÂµÃÂ¹ÃÂ´ÃÂ¶ Ã‘â‚¬Ã‘ÂÃÂ´ÃÂ¾ÃÂ¼ Ã‘Â
	// Ã‘â€¦ÃÂ¾Ã‘ÂÃ‘â€šÃÂ½ÃÂµÃÂ¹ÃÂ¼ÃÂ¾ÃÂ¼ ÃÂ² Ã‘Ë†ÃÂ°ÃÂ¿ÃÂºÃÂµ. Ãâ€”ÃÂ½ÃÂ°Ã‘â€¡ÃÂµÃÂ½ÃÂ¸ÃÂµ ÃÂ¿ÃÂ¾ÃÂ´Ã‘ÂÃ‘â€šÃÂ°ÃÂ²ÃÂ»Ã‘ÂÃÂµÃ‘â€šÃ‘ÂÃ‘Â ÃÂ² CSS url(), ÃÂ¿ÃÂ¾Ã‘ÂÃ‘â€šÃÂ¾ÃÂ¼Ã‘Æ’ Ã‘ÂÃ‘â€šÃ‘â‚¬ÃÂ¾ÃÂ³ÃÂ¸ÃÂ¹
	// allowlist: FileReader ÃÂ²Ã‘ÂÃÂµÃÂ³ÃÂ´ÃÂ° ÃÂ¾Ã‘â€šÃÂ´ÃÂ°Ã‘â€˜Ã‘â€š "data:<type>;base64,<...>", ÃÂ° ÃÂ»Ã‘Å½ÃÂ±ÃÂ¾ÃÂ¹
	// Ã‘ÂÃÂ¸ÃÂ¼ÃÂ²ÃÂ¾ÃÂ» ÃÂ²ÃÂ½ÃÂµ Ã‘ÂÃ‘â€šÃÂ¾ÃÂ³ÃÂ¾ ÃÂ½ÃÂ°ÃÂ±ÃÂ¾Ã‘â‚¬ÃÂ° ÃÂ¼ÃÂ¾ÃÂ³ ÃÂ±Ã‘â€¹ ÃÂ·ÃÂ°ÃÂºÃ‘â‚¬Ã‘â€¹Ã‘â€šÃ‘Å’ url() ÃÂ¸ ÃÂ²ÃÂ½ÃÂµÃÂ´Ã‘â‚¬ÃÂ¸Ã‘â€šÃ‘Å’ Ã‘ÂÃÂ²ÃÂ¾ÃÂ¹ CSS.
	var LOGO_RE = /^data:image\/(?:png|jpeg|gif|webp|svg\+xml);base64,[A-Za-z0-9+/=]+$/;
	function applyHostnameLogo() {
		var root = document.documentElement;
		var on = localStorage.getItem('proton-login-branding') === 'true';
		var logo = on ? (localStorage.getItem('proton-login-logo') || '') : '';
		if (logo && logo.length < 300001 && LOGO_RE.test(logo)) {
			root.style.setProperty('--proton-hostname-logo', 'url("' + logo + '")');
			root.classList.add('proton-hostname-logo');
		} else {
			root.style.removeProperty('--proton-hostname-logo');
			root.classList.remove('proton-hostname-logo');
		}
	}
	applyHostnameLogo();
	window.protonApplyHostnameLogo = applyHostnameLogo;
	// UCI Ã¢â‚¬â€ ÃÂ¸Ã‘ÂÃ‘â€šÃÂ¾Ã‘â€¡ÃÂ½ÃÂ¸ÃÂº ÃÂ¸Ã‘ÂÃ‘â€šÃÂ¸ÃÂ½Ã‘â€¹, ÃÂ½ÃÂ¾ Ã‘ÂÃÂ¸ÃÂ½Ã‘â€¦Ã‘â‚¬ÃÂ¾ÃÂ½ÃÂ¸ÃÂ·ÃÂ°Ã‘â€ ÃÂ¸Ã‘Â ÃÂ°Ã‘ÂÃÂ¸ÃÂ½Ã‘â€¦Ã‘â‚¬ÃÂ¾ÃÂ½ÃÂ½ÃÂ°: ÃÂ±ÃÂµÃÂ· Ã‘ÂÃ‘â€šÃÂ¾ÃÂ³ÃÂ¾ ÃÂ»ÃÂ¾ÃÂ³ÃÂ¾Ã‘â€šÃÂ¸ÃÂ¿ ÃÂ²
	// ÃÂ½ÃÂ¾ÃÂ²ÃÂ¾ÃÂ¼ ÃÂ±Ã‘â‚¬ÃÂ°Ã‘Æ’ÃÂ·ÃÂµÃ‘â‚¬ÃÂµ ÃÂ¿ÃÂ¾Ã‘ÂÃÂ²ÃÂ¸ÃÂ»Ã‘ÂÃ‘Â ÃÂ±Ã‘â€¹ Ã‘â€šÃÂ¾ÃÂ»Ã‘Å’ÃÂºÃÂ¾ Ã‘ÂÃÂ¾ ÃÂ²Ã‘â€šÃÂ¾Ã‘â‚¬ÃÂ¾ÃÂ¹ ÃÂ·ÃÂ°ÃÂ³Ã‘â‚¬Ã‘Æ’ÃÂ·ÃÂºÃÂ¸ Ã‘ÂÃ‘â€šÃ‘â‚¬ÃÂ°ÃÂ½ÃÂ¸Ã‘â€ Ã‘â€¹.
	window.addEventListener('proton-settings-synced', applyHostnameLogo);

	// ÃÂ£Ã‘ÂÃ‘â€šÃÂ°ÃÂ½ÃÂ°ÃÂ²ÃÂ»ÃÂ¸ÃÂ²ÃÂ°ÃÂµÃÂ¼ Ã‘â€žÃÂ¾ÃÂ½ÃÂ¾ÃÂ²Ã‘â€¹ÃÂ¹ Ã‘â€ ÃÂ²ÃÂµÃ‘â€š Ãâ€ÃÅ¾ ÃÂ·ÃÂ°ÃÂ³Ã‘â‚¬Ã‘Æ’ÃÂ·ÃÂºÃÂ¸ cascade.css, Ã‘â€¡Ã‘â€šÃÂ¾ÃÂ±Ã‘â€¹ ÃÂ¸ÃÂ·ÃÂ±ÃÂµÃÂ¶ÃÂ°Ã‘â€šÃ‘Å’ ÃÂ¼ÃÂµÃ‘â‚¬Ã‘â€ ÃÂ°ÃÂ½ÃÂ¸Ã‘Â ÃÂ³Ã‘â‚¬ÃÂ°ÃÂ´ÃÂ¸ÃÂµÃÂ½Ã‘â€šÃÂ°
	var bgSolid = themeMode === 'light' ? '#ffffff' : '#0f1419';
	document.documentElement.style.setProperty('background-color', bgSolid);
})();
